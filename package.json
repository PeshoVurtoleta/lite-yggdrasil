{
  "name": "@zakkster/lite-yggdrasil",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "version": "0.0.0",
  "description": "Zero-dependency, zero-GC summary tree for mutable ordered sequences: SumSequence inserts, removes and resizes anywhere in O(log n) and seeks by any running total (count, pixels, bytes, milliseconds) over 1 to 4 integer measures per element.",
  "type": "module",
  "main": "./Yggdrasil.js",
  "module": "./Yggdrasil.js",
  "types": "./Yggdrasil.d.ts",
  "exports": {
    ".": {
      "types": "./Yggdrasil.d.ts",
      "node": "./Yggdrasil.js",
      "import": "./Yggdrasil.js",
      "default": "./Yggdrasil.js"
    }
  },
  "files": [
    "Yggdrasil.js",
    "Yggdrasil.d.ts",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:types": "tsc -p test/types/tsconfig.json",
    "test:lanes": "node test/engine-lanes.mjs",
    "torture": "node --expose-gc --min-semi-space-size=4 --max-semi-space-size=4 --no-concurrent-recompilation test/torture.mjs",
    "verify": "npm test && npm run test:types && npm run test:lanes && npm run torture"
  },
  "keywords": [
    "sum-tree",
    "summary-tree",
    "ordered-sequence",
    "prefix-sum",
    "order-statistics",
    "rope",
    "virtual-list",
    "timeline",
    "zero-gc",
    "typed-array",
    "data-structures",
    "zero-dependency"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@zakkster/lite-gc-profiler": "^1.16.0",
    "@zakkster/lite-leak": "^1.10.0",
    "@zakkster/lite-perf-gate": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "homepage": "https://github.com/PeshoVurtoleta/lite-yggdrasil#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-yggdrasil.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-yggdrasil/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "engines": {
    "node": ">=18"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "sideEffects": false
}
